AI_PROVIDER=deepseek
ROUTER_PORT=8082

DEEPSEEK_API_KEY=sk-your-real-key-here
# deepseek-v4-pro  → heavy tasks (Sonnet/Opus mapping)
# deepseek-v4-flash → fast/cheap tasks (Haiku mapping)
# Note: deepseek-chat is deprecated on 2026-07-24 (maps to deepseek-v4-flash)
DEEPSEEK_BIG_MODEL=deepseek-v4-pro
DEEPSEEK_SMALL_MODEL=deepseek-v4-flash

NVIDIA_API_KEY=nvapi-your-real-key-here
NVIDIA_BIG_MODEL=deepseek-ai/deepseek-v3.2
NVIDIA_SMALL_MODEL=deepseek-ai/deepseek-v3.2

# Gemini API
GEMINI_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_DEFAULT_MODEL=gemini/gemini-2.5-flash # default Claude Code
GEMINI_BIG_MODEL=gemini/gemini-3-flash-preview # smart/heavy tasks
GEMINI_SMALL_MODEL=gemini/gemini-2.5-flash-lite # cron jobs / cheap tasks
