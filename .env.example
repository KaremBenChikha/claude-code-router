AI_PROVIDER=deepseek
ROUTER_PORT=8082

DEEPSEEK_API_KEY=sk-your-real-key-here

# deepseek-v4-pro   → heavy tasks (Claude Sonnet / Opus routing)
# deepseek-v4-flash → fast/cheap tasks (Claude Haiku routing)
# NOTE: deepseek-chat / deepseek-reasoner are DEPRECATED 2026-07-24
#       they auto-map to deepseek-v4-flash — update now to avoid disruption.
DEEPSEEK_BIG_MODEL=deepseek-v4-pro
DEEPSEEK_SMALL_MODEL=deepseek-v4-flash
